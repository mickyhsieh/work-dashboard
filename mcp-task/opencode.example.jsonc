{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mickey-tasks": {
        "type": "remote",
        "url": "https://<PROJECT_REF>.supabase.co/functions/v1/mcp-task",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MCP_TASK_TOKEN}"
        }
      }
    }
  }
}
